{
  "name": "robot-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Citation-first encyclopedia of modern robot learning.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3200",
    "prebuild": "node scripts/prune-next-type-duplicates.ts && node scripts/prune-generated-og-shadows.ts && npm run validate:content && node scripts/check-tektur-fonts.ts && node scripts/check-og-renderer-fonts.ts",
    "build": "next build && node scripts/measure-reading-times.ts --rebuild",
    "vercel-build": "npm run build && node scripts/check-article-boxes.ts && node scripts/check-article-sources.ts",
    "postbuild": "node scripts/prune-export-artifacts.ts && node scripts/patch-404-guard.ts && node scripts/build-search.ts && node scripts/lint-prose.ts && npm run check:figure-system && node scripts/check-seo.ts && node scripts/measure-discovery-prose.ts --check && node scripts/check-internal-links.ts && npm run generate:og-cards",
    "refresh": "npm run generate:motion-tokens && npm run generate:motion-equations && npm run generate:companies && npm run generate:content-dates && npm run build",
    "pretypecheck": "node scripts/prune-next-type-duplicates.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "prelint": "node scripts/postinstall.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.ts && node scripts/lint-prose.ts --source-only && node scripts/check-chart-descriptions.ts && node scripts/check-motion-tokens.ts",
    "generate:motion-tokens": "node scripts/generate-motion-tokens.ts",
    "generate:motion-equations": "node scripts/generate-motion-equations.ts",
    "generate:motion-clips": "node scripts/generate-motion-clips.ts",
    "generate:companies": "node scripts/generate-companies.ts",
    "generate:content-dates": "node scripts/generate-content-dates.ts",
    "pregenerate:og-cards": "node scripts/prune-generated-og-shadows.ts",
    "generate:og-cards": "node scripts/generate-og-cards.ts",
    "check:figure-system": "node scripts/check-figure-system.ts",
    "check:links": "node scripts/check-citation-links.ts",
    "check:citations": "node scripts/check-citations.ts",
    "check:crossref-authors": "node scripts/check-crossref-authors.ts",
    "check:dataset-sources": "node scripts/check-dataset-sources.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@types/mdx": "2.0.14",
    "@vercel/analytics": "2.0.1",
    "d3": "7.9.0",
    "gray-matter": "4.0.3",
    "katex": "0.18.1",
    "minisearch": "7.2.0",
    "motion": "13.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx-frontmatter": "5.2.0",
    "shiki": "4.4.2",
    "three": "0.185.1",
    "urdf-loader": "0.13.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "draco3d": "1.5.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "fontkit": "2.0.4",
    "jsdom": "30.0.1",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "undici": "8.10.0",
    "vitest": "4.1.10"
  }
}
