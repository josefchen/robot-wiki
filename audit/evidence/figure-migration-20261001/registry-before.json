      "cases": [
        {
          "id": "default",
          "kind": "default"
        },
        {
          "id": "focus-each-control",
          "kind": "focus",
          "selector": "button, input, select, summary, [tabindex]",
          "expectedEnumeration": "every rendered enabled control independently"
        },
        {
          "id": "meaningful-hover",
          "kind": "hover",
          "selector": "button:not(:disabled)",
          "expectedEnumeration": "every rendered button with a hover treatment"
        },
        {
          "id": "slider-boundaries-and-anchors",
          "kind": "slider-boundaries",
          "selector": "input[type=\"range\"]",
          "expectedEnumeration": "each slider at min, documented default, max, source anchors, and registered discontinuities"
        },
        {
          "id": "discrete-options",
          "kind": "discrete-options",
          "selector": "[aria-pressed], [aria-selected], input[type=\"radio\"], input[type=\"checkbox\"], select, details",
          "expectedEnumeration": "every rendered discrete option independently"
        },
        {
          "id": "reset",
          "kind": "reset"
        },
        {
          "id": "pairwise-independent-controls",
          "kind": "pairwise",
          "expectedEnumeration": "deterministic IPOG pairwise combinations, seed brand-v2-state-v1"
        },
        {
          "id": "loading-not-applicable",
          "kind": "exception",
          "notApplicableReason": "Source does not implement a loading state."
        },
        {
          "id": "error-witness",
          "kind": "discrete-options",
          "expectedEnumeration": "one deterministic implemented error witness"
        },
        {
          "id": "empty-not-applicable",
          "kind": "exception",
          "notApplicableReason": "Source does not implement a empty state."
        },
        {
          "id": "unavailable-not-applicable",
          "kind": "exception",
          "notApplicableReason": "Source does not implement a unavailable state."
        }
      ],
      "expectedCaseCount": 11,
      "fingerprint": "a970761c6eda3429699b86c4a5c0ccc9eaaaa690aa430e3a1d03fa9643713e9a"
