    {
      "name": "kinematics-375",
      "viewport": {
        "width": 375,
        "height": 812
      },
      "observedAt": "2026-09-24T01:11:47.581Z",
      "surface": "kinematics",
      "glossary": [
        {
          "id": "inverse-kinematics",
          "resolves": true,
          "tooltipObserved": true,
          "definition": "The reverse of the forward map: given a target pose for the end effector, find joint angles that reach it. The problem is nonlinear and can have no solution, one solution, or many. Numerical methods can search iteratively for a solution."
        },
        {
          "id": "denavit-hartenberg-parameters",
          "resolves": true,
          "tooltipObserved": true,
          "definition": "A four-parameter representation of a kinematic chain. LaValle describes revolute chains using an axial offset, an angle about the joint axis, the distance between successive axes, and the angle between those axes. Frame assignment, indexing and transform order must be specified; do not mix conventions. Near-parallel joint axes can make the parameters ill-conditioned; the product-of-exponentials formulation avoids that parameterization problem."
        }
      ],
      "checkedText": [
        "LaValle describes",
        "3D kinematics playground",
        "±0.5mm"
      ],
      "dom": {
        "path": "audit/evidence/residual-release-20260924/classical/kinematics-375.dom.json",
