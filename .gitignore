# Throwaway visual-verification scripts (never committed by convention) and
# the desktop sync tool's Finder-style " N" duplicates, which break typecheck
# with duplicate declarations if one ever lands at the repo root.
visual-*.mts
* [0-9].*
* [0-9]/

# Throwaway scripts in the older improvised naming (same rule as
# visual-*.mts: never committed, and a sync-tool duplication target at the
# repo root).
*.tmp.mts
*.tmp.ts

# Generated by postbuild (scripts/build-search.ts) on every build, local and
# Vercel alike; regenerated, never committed.
public/search-index.json

# Crossref author-sweep response cache (scripts/check-crossref-authors.ts);
