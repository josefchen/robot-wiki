# Text normalization and binary handling for the assets this repo ships.
#
# Every source, content, and data file is LF text; declaring it here means a
# clone on Windows cannot rewrite line endings into the export or into the
# reading-time and search-index measurements that read those files back.
#
# Binary assets are marked -text so git never line-normalizes or diffs them:
# a normalized GLB or WASM file is a corrupted one, and a textual diff of a
# 700 KB JPEG is noise in every review. Their size is governed by the byte
# budgets in lib/file-size.ts (npm run check:file-size), which is where an
# oversized asset gets stopped.
* text=auto eol=lf

# Robot models and meshes (SO-101 playground).
*.glb -text
*.gltf -text
*.bin -text
*.stl -text
*.dae -text

# Raster images and fonts.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.avif -text
*.ico -text
*.woff -text
*.woff2 -text
*.ttf -text
*.otf -text

# Vendored WebAssembly (Draco decoder).
*.wasm -text

# Generated by npm: collapse it in reviews, where the source of truth is
# package.json rather than the resolved tree. The diff stays available.
package-lock.json linguist-generated=true
